{
  "name": "pilo-core",
  "version": "0.12.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./ariaTree": {
      "types": "./dist/browser/ariaTree/index.d.ts",
      "import": "./dist/browser/ariaTree/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist src/browser/ariaTree/bundle.ts",
    "bundle:aria": "tsx scripts/bundle-aria-tree.ts",
    "build": "pnpm run bundle:aria && tsc",
    "pretest": "pnpm run bundle:aria",
    "typecheck": "pnpm run bundle:aria && tsc --project tsconfig.check.json",
    "test": "vitest run",
    "test:only": "pnpm run bundle:aria && pnpm run test",
    "test:integration": "pnpm run bundle:aria && PILO_BIDI_INTEGRATION=1 vitest run test/integration",
    "generate:schemas": "ts-json-schema-generator --path src/events.ts --tsconfig tsconfig.json --type AutomateStreamEvent --out schemas/webagent-event.json && node scripts/normalize-schema.cjs schemas/webagent-event.json",
    "check:schemas": "pnpm run generate:schemas && git diff --exit-code schemas/"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/google-vertex": "^5.0.22",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "@ghostery/adblocker-playwright": "^2.18.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tabstack/sdk": "^2.3.0",
    "ai": "^7.0.31",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "cross-fetch": "^4.1.0",
    "eventemitter3": "^5.0.4",
    "liquidjs": "^10.27.2",
    "nanoid": "^6.0.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "playwright": "1.62.0",
    "turndown": "^7.2.2",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.1"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^29.0.2",
    "ts-json-schema-generator": "2.9.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
