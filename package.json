{
  "name": "@tabstack/pilo",
  "version": "0.0.0-dev",
  "description": "AI-powered web automation library and CLI tool",
  "repository": "github:mozilla/pilo",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/core/src/index.d.ts",
      "import": "./dist/core/src/index.js"
    }
  },
  "main": "./dist/core/src/index.js",
  "types": "./dist/core/src/index.d.ts",
  "bin": {
    "pilo": "./dist/cli/src/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "pnpm --filter pilo-core run build",
    "prebuild": "pnpm --filter pilo-core run build && pnpm --filter pilo-extension run build:publish",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "pnpm -r run clean && rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run pretest && pnpm run format:check && pnpm -r run typecheck",
    "pretest": "pnpm --filter pilo-core run bundle:aria",
    "test": "pnpm -r run test",
    "check": "pnpm run typecheck && pnpm --filter pilo-core run check:schemas && pnpm run test",
    "pilo": "pnpm --filter pilo-cli run pilo",
    "smoke-eval": "node scripts/smoke-eval/run.mjs",
    "dev:extension": "pnpm --filter pilo-extension run dev --",
    "dev:server": "pnpm --filter pilo-server run dev"
  },
  "keywords": [
    "ai",
    "automation",
    "web-scraping",
    "playwright",
    "browser-automation",
    "cli"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/google": "^4.0.24",
    "@ai-sdk/google-vertex": "^5.0.31",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ghostery/adblocker-playwright": "^2.18.1",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.37",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "cross-fetch": "^4.1.0",
    "eventemitter3": "^5.0.4",
    "liquidjs": "^10.28.0",
    "nanoid": "^6.0.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "playwright": "1.62.0",
    "turndown": "^7.2.2",
    "web-ext": "^10.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "prettier": "^3.9.3",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "zod": "4.3.6",
      "shell-quote": ">=1.8.4",
      "undici": ">=7.28.0",
      "tmp": ">=0.2.6"
    }
  }
}
