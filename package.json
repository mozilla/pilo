{
  "name": "@tabstack/pilo",
  "version": "0.0.0-dev",
  "description": "AI-powered web automation library and CLI tool",
  "repository": "github:mozilla/pilo",
  "type": "module",
  "engines": {
    "node": "^22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/core/src/index.d.ts",
      "import": "./dist/core/src/index.js"
    }
  },
  "main": "./dist/core/src/index.js",
  "types": "./dist/core/src/index.d.ts",
  "bin": {
    "pilo": "./dist/cli/src/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "pnpm --filter pilo-core run build",
    "prebuild": "pnpm --filter pilo-core run build && pnpm --filter pilo-extension run build:publish",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "pnpm -r run clean && rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run pretest && pnpm run format:check && pnpm -r run typecheck",
    "pretest": "pnpm --filter pilo-core run bundle:aria",
    "test": "pnpm -r run test",
    "check": "pnpm run typecheck && pnpm --filter pilo-core run check:schemas && pnpm run test",
    "pilo": "pnpm --filter pilo-cli run pilo",
    "smoke-eval": "node scripts/smoke-eval/run.mjs",
    "dev:extension": "pnpm --filter pilo-extension run dev --",
    "dev:server": "pnpm --filter pilo-server run dev"
  },
  "keywords": [
    "ai",
    "automation",
    "web-scraping",
    "playwright",
    "browser-automation",
    "cli"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/google-vertex": "^4.0.137",
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@ghostery/adblocker-playwright": "^2.17.3",
    "@openrouter/ai-sdk-provider": "^2.8.0",
    "ai": "^6.0.191",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cross-fetch": "^4.1.0",
    "eventemitter3": "^5.0.4",
    "liquidjs": "^10.27.0",
    "nanoid": "^5.1.7",
    "ollama-ai-provider-v2": "^3.5.1",
    "playwright": "1.60.0",
    "turndown": "^7.2.2",
    "web-ext": "^10.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    }
  }
}
